rules_version = '2';

// Day-one lockdown (SPEC §E): clients touch only their own data; cases,
// availability, and subscription lifecycle are written ONLY by the Worker's
// service account (which bypasses these rules). The single client-writable
// surface on parent docs is the `lastMessage` chat pointer.
// No open test mode, ever.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // MANY ADVOCATES (Eric, 2026-10-15: "Advocates must never be able to
    // access another advocate's cases or data."). An advocate is a user the
    // Worker gave role 'advocate' (nobody can give it to themselves: see
    // users below) whose advocates/{uid} record is active. They reach a case
    // or a chat line only when its advocateId is their own uid; the Worker
    // checks the same thing on every route.
    // And (2026-10-16) set up, with a password of their own, and signed in
    // since he last reset it or turned them off: auth_time is when the
    // session began and survives every refresh, so a session from before a
    // reset or a turn-off reads nothing.
    function isAdvocate() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'advocate'
        && get(/databases/$(database)/documents/advocates/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/advocates/$(request.auth.uid)).data.get('mustChange', false) != true
        && get(/databases/$(database)/documents/advocates/$(request.auth.uid)).data.get('onboardedAt', null) != null
        && request.auth.token.auth_time >= get(/databases/$(database)/documents/advocates/$(request.auth.uid)).data.get('sessionsFrom', 0);
    }

    function isAdvocateOf(data) {
      return signedIn() && data.advocateId == request.auth.uid && isAdvocate();
    }

    // The advocate side of a thread: the admin on every one, an advocate on
    // their own. Their messages carry role 'admin', the advocate side's role
    // everywhere in the app.
    function worksThread(data) {
      return isAdmin() || isAdvocateOf(data);
    }

    function validMessage(staffSide) {
      return request.resource.data.keys().hasOnly(['from', 'role', 'text', 'ts', 'attachment'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        // a message is words, a file, or both — never neither
        && (request.resource.data.text.size() > 0
            || request.resource.data.keys().hasAny(['attachment']))
        && (staffSide
            ? request.resource.data.role == 'admin'
            : request.resource.data.role == 'client')
        // A file is one this app stored (2026-10-16): a link to anywhere
        // else, named like a lab result, is refused.
        && (!request.resource.data.keys().hasAny(['attachment'])
            || (request.resource.data.attachment is map
                && request.resource.data.attachment.url is string
                && request.resource.data.attachment.url.matches('^https://firebasestorage[.]googleapis[.]com/.*')));
    }

    function onlyLastMessageChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage']);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // A user may create/update their own profile but can never grant
      // themselves a role other than 'client'. The role defaults to 'client'
      // on both sides so a starter record with no role yet (created by the
      // code-login server step, which only stores email) can be completed into
      // a full client profile — while an admin can never be demoted or a
      // client self-promoted.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'client') == 'client';
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'client') == resource.data.get('role', 'client');
      allow delete: if false;
    }

    match /cases/{caseId} {
      // Case docs are created and mutated by the Worker — except the
      // lastMessage pointer, which chat participants may update.
      allow read: if signedIn() &&
        (resource.data.clientUid == request.auth.uid || worksThread(resource.data));
      allow update: if signedIn()
        && (resource.data.clientUid == request.auth.uid || worksThread(resource.data))
        && onlyLastMessageChanged();
      allow create, delete: if false;


      // The private advisor. Admin-only by rule, Worker-written only: a client
      // must never be able to read Eric's working assessment of their own case,
      // and nothing outside the Worker may write one.
      match /advisor/{document=**} {
        allow read: if signedIn() && isAdmin();
        allow write: if false;
      }

      // Eric's private notes on the case — Worker-only in both directions
      // (served back through the admin-gated advisor state endpoint). The
      // case doc itself is client-readable, so nothing private sits on it.
      match /private/{document=**} {
        allow read, write: if false;
      }

      // Case chat: dies with the case (SPEC §H-6 — separate from subscriber chat).
      match /chat/{msgId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/cases/$(caseId)).data.clientUid == request.auth.uid
            || worksThread(get(/databases/$(database)/documents/cases/$(caseId)).data));
        allow create: if signedIn()
          && (get(/databases/$(database)/documents/cases/$(caseId)).data.clientUid == request.auth.uid
              || worksThread(get(/databases/$(database)/documents/cases/$(caseId)).data))
          && get(/databases/$(database)/documents/cases/$(caseId)).data.status != 'closed'
          && validMessage(worksThread(get(/databases/$(database)/documents/cases/$(caseId)).data));
        allow update, delete: if false;
      }
    }

    // Advisor work queue — Worker-only in both directions; nothing in the
    // browser has any business here.
    match /advisorQueue/{jobId} {
      allow read, write: if false;
    }

    // Eric's medical vocabulary (Key terms + learned flags) — Worker-only.
    match /advisorKnowledge/{termId} {
      allow read, write: if false;
    }

    // How Eric edits the advisor's drafts, and the style profile distilled
    // from those edits — Worker-only in both directions.
    match /advisorStyle/{document=**} {
      allow read, write: if false;
    }

    // Folder covers for the admin dashboard (the advisor's working line, or
    // Eric's override). Worker-only: the case doc is client-readable, so the
    // working read lives here instead, served via GET /api/advisor/covers.
    match /caseMeta/{caseId} {
      allow read, write: if false;
    }

    match /availability/{slotId} {
      // Open slots are world-readable so the picker works pre-payment;
      // Worker-writable only. A booked or held slot carries the case, the
      // client's uid and the lead (security review, 2026-10-16), so only he
      // reads those; every public page asks for state == 'open' already.
      allow read: if resource.data.state == 'open' || isAdmin();
      allow write: if false;
    }

    match /subscriptions/{uid} {
      // Lifecycle fields come from Stripe webhooks via the Worker.
      allow read: if signedIn() && (request.auth.uid == uid || worksThread(resource.data));
      allow update: if signedIn()
        && (request.auth.uid == uid || worksThread(resource.data))
        && onlyLastMessageChanged();
      allow create, delete: if false;

      // Subscriber chat: lives as long as the subscription (access runs to
      // the end of the paid period — currentPeriodEnd is Worker-maintained).

      // The private advisor. Admin-only by rule, Worker-written only: a client
      // must never be able to read Eric's working assessment of their own case,
      // and nothing outside the Worker may write one.
      match /advisor/{document=**} {
        allow read: if signedIn() && isAdmin();
        allow write: if false;
      }

      // Eric's private notes on the subscriber — Worker-only in both
      // directions, same reasoning as the case-side private subtree.
      match /private/{document=**} {
        allow read, write: if false;
      }

      match /chat/{msgId} {
        allow read: if signedIn() && (request.auth.uid == uid
          || worksThread(get(/databases/$(database)/documents/subscriptions/$(uid)).data));
        allow create: if signedIn()
          && validMessage(worksThread(get(/databases/$(database)/documents/subscriptions/$(uid)).data))
          && (worksThread(get(/databases/$(database)/documents/subscriptions/$(uid)).data)
              || (request.auth.uid == uid
                  && request.time < get(/databases/$(database)/documents/subscriptions/$(uid)).data.currentPeriodEnd));
        allow update, delete: if false;
      }
    }

    match /settings/{doc} {
      // PUBLIC COPY ONLY. Everything under settings/ is world-readable to
      // anybody who knows the project id, so a document belongs here only if
      // every field in it is something Eric would print on the landing page.
      // Not just the field the Worker chooses to serve: the whole document.
      //
      // e.g. settings/booking.closedUntil, the date the calendar is shut
      // until, which the booking page prints to anybody who visits it.
      //
      // Timestamps of Eric's own decisions are NOT public copy. The in-office
      // switch stores the minute he last flipped it, so it lives on
      // config/officeHours instead and only the Worker can read it. Anything
      // that would let somebody with a polling script reconstruct his week
      // goes to config/ and is served, or not served, by worker/index.js.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else, config/ included, is the service account's alone. The
    // Worker bypasses these rules; a browser is refused whether it is signed
    // in, signed out, or holding an admin claim.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
