rules_version = '2';

// Files live under cases/{caseId}/... — readable only by the case's client
// and the admin. Clients may write only into uploads/ while the case is open
// (25 MB per file); recordings and reports are the admin's to place, with no
// size cap (recordings are big). Overlapping match blocks are OR'd.
service firebase.storage {
  match /b/{bucket}/o {

    function caseData(caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId)).data;
    }

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCaseClient(caseId) {
      return request.auth != null && caseData(caseId).clientUid == request.auth.uid;
    }

    // MANY ADVOCATES (2026-10-15): an active advocate reaches the files of
    // their own cases, and of no one else's. The same three facts
    // firestore.rules checks: role advocate, an active record, their uid on
    // the case.
    // And (2026-10-16) set up, and signed in since the last reset or turn-off.
    function isAdvocate() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'advocate'
        && firestore.get(/databases/(default)/documents/advocates/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/advocates/$(request.auth.uid)).data.get('mustChange', false) != true
        && firestore.get(/databases/(default)/documents/advocates/$(request.auth.uid)).data.get('onboardedAt', null) != null
        && request.auth.token.auth_time >= firestore.get(/databases/(default)/documents/advocates/$(request.auth.uid)).data.get('sessionsFrom', 0);
    }

    function isCaseAdvocate(caseId) {
      return request.auth != null && caseData(caseId).advocateId == request.auth.uid && isAdvocate();
    }

    function isSubAdvocate(uid) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/subscriptions/$(uid)).data.advocateId == request.auth.uid
        && isAdvocate();
    }

    // Named folders, not a recursive wildcard. The wildcard meant that anything
    // ever placed under cases/{id}/ was instantly client-readable — one manual
    // upload of working notes or a prep sheet into that prefix and it would be
    // on their screen. These four are the folders a client is entitled to.
    match /cases/{caseId}/{folder}/{fileName} {
      allow read: if (folder in ['report', 'recording', 'uploads', 'chat-files']) &&
        (isCaseClient(caseId) || isAdmin() || isCaseAdvocate(caseId));
    }

    match /cases/{caseId}/{allPaths=**} {
      allow read: if isAdmin() || isCaseAdvocate(caseId);
      allow write: if isAdmin() || isCaseAdvocate(caseId);
    }

    // A client adds a file; they never overwrite one, delete one, or label
    // it (security review, 2026-10-16). Labels (paCategory, paName,
    // paStarred) are how a file shows as filed, say as the report, so only
    // the advocate side sets them, through the rule above or the Worker.
    function noLabels() {
      return request.resource.metadata == null
        || !request.resource.metadata.keys().hasAny(['paCategory', 'paName', 'paStarred']);
    }

    match /cases/{caseId}/uploads/{fileName} {
      allow create: if isCaseClient(caseId) &&
        caseData(caseId).status != 'closed' &&
        request.resource.size < 25 * 1024 * 1024 && noLabels();
    }

    // Files shared inside a case chat (either side, while the case is open).
    // The client's side adds, as above; the advocate side may also replace.
    match /cases/{caseId}/chat-files/{fileName} {
      allow create: if isCaseClient(caseId) &&
        caseData(caseId).status != 'closed' &&
        request.resource.size < 25 * 1024 * 1024 && noLabels();
      allow write: if (isAdmin() || isCaseAdvocate(caseId)) &&
        caseData(caseId).status != 'closed' &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // Files shared inside a subscriber chat.
    match /subscriptions/{uid}/chat-files/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isSubAdvocate(uid));
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin() || isSubAdvocate(uid)) &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // The client's profile shelf: chat attachments promoted via long-press
    // "save" land here and follow the person, not the case.
    match /profiles/{uid}/saved/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin()) &&
        request.resource.size < 25 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
