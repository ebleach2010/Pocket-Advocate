# Copy to .dev.vars for local `wrangler dev`. NEVER commit .dev.vars.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=re_xxx
# The full Firebase service-account JSON on one line (Project settings → Service accounts).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}
# Optional: the Trade portal's market data key. Without it, the key pasted in the portal is used.
# FINNHUB_KEY=xxx
# Optional: the desk's 15-minute charts (Alpaca's free plan). Without them, the pair pasted in Settings is used.
# ALPACA_KEY_ID=xxx
# ALPACA_SECRET=xxx
