// Cloudflare Worker config — same assets-hosting pattern as the Tether repo.
// The Worker serves the static app from public/ and is the ONLY server-side code:
// Stripe Checkout creation, the Stripe webhook (which creates cases and syncs
// subscriptions), the scheduling trust boundary (72h lead time, 8am–6pm MST,
// slot holds), the admin API, and the chat email digest cron.
{
  "name": "pocket-advocate",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The Anthropic SDK (advisor) imports node:path / node:fs on its
  // credential-file code path. We always pass an explicit apiKey so that path
  // never runs, but the imports still have to resolve or the Worker fails to
  // load at all — which would take the whole site down, not just the advisor.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Static assets are normally served WITHOUT invoking the Worker at all,
    // which is why the admin asset gate in worker/index.js never ran: a
    // request for /js/advisor.js matched a file and was answered before any
    // of our code saw it. Running the Worker first is what makes the gate a
    // gate. Everything it does not claim still falls through to ASSETS.
    "run_worker_first": true
  },
  "triggers": {
    // Every minute: the advisor queue drains one job per firing, and with
    // routine passes running delta (1-3 min) a per-minute firing means reads
    // start and retry within a minute. scheduled() gates everything heavier
    // to the 5- and 15-minute marks, so the cost of the cadence is one queue
    // list per minute.
    "crons": ["* * * * *"]
  },
  // Five minutes of CPU per invocation (paid plan) instead of the 30 second
  // default. Streaming a model turn burns real CPU in workerd (~10-16% duty,
  // measured live 2026-08-24), so the default killed every foreground turn
  // near the four minute mark, silently. This raises the fetch path and,
  // with it, the Workflow steps below.
  "limits": { "cpu_ms": 300000 },
  "vars": {
    // Non-secret config. Replace after creating the Firebase project (docs/SETUP.md).
    "FIREBASE_PROJECT_ID": "pocket-advocate-f3148",
    "FIREBASE_WEB_API_KEY": "AIzaSyBDH8QZxGYBWytbxx7aNM0uyUIOqRj-7T8",
    // Where success/cancel URLs point. thepocketadvocates.com is the production
    // domain (Eric's, 2026-07-12); switch to http://localhost:8787 for local dev.
    "PUBLIC_BASE_URL": "https://thepocketadvocates.com",
    // Email (Resend). EMAIL_FROM must be a verified sender/domain in Resend.
    "EMAIL_FROM": "Pocket Advocate <no-reply@thepocketadvocates.com>",
    "ADMIN_EMAIL": "pocketadvocate.eric@gmail.com",
    // Eric's admin auth uid — the PIN sign-in mints a session for this user.
    "ADMIN_UID": "xnQf5en2BcMStjMmzQDBv33WJIv2",
    // Native Web Push (RFC 8292 VAPID). Public applicationServerKey + contact.
    "VAPID_PUBLIC_KEY": "BEYXJvRQkNcn01FzAP3_zx0suQlmh_rEjBxIYDtT2oCrtP2hunlAqV47PkjoCS1aiPb4lszik8df64o0HwFSNQ4",
    "VAPID_SUBJECT": "mailto:pocketadvocate.eric@gmail.com",
    // Live Stripe customer-portal configuration (cancel at period end).
    "STRIPE_PORTAL_CONFIG": "bpc_1TwFooCd0S5yK0YTvc5gYsPQ"
  }
  // Secrets (never in this file — `wrangler secret put NAME`, or .dev.vars locally):
  //   STRIPE_SECRET_KEY          sk_live_... / sk_test_...
  //   STRIPE_WEBHOOK_SECRET      whsec_...
  //   FIREBASE_SERVICE_ACCOUNT   full service-account JSON, one line
  //   RESEND_API_KEY             re_...
  //   ANTHROPIC_API_KEY          sk-ant-...  (the 👨‍⚕️ Advisor; without it the
  //                              advisor panel shows an error and nothing else breaks)
}
